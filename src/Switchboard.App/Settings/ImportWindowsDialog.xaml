<Window x:Class="Switchboard.App.Settings.ImportWindowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from running windows"
        Width="720" Height="520" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FF202329"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <DockPanel Margin="18,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Import from running windows" FontSize="17" FontWeight="SemiBold"
                 Foreground="{StaticResource SettingsText}" />
      <TextBlock Margin="0,2,0,12" FontSize="12.5" TextWrapping="Wrap"
                 Foreground="{StaticResource SettingsMuted}"
                 Text="Windows Terminal windows that are not bound to a registered terminal. Importing registers each one and binds it to the live window — nothing is launched or restarted." />
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource SettingsMuted}" Text="{Binding Summary}" />
      <Button DockPanel.Dock="Right" Content="Import" Margin="0" Padding="14,5" FontSize="13"
              FontWeight="SemiBold" Cursor="Hand" Foreground="#FF0B1020"
              Background="{StaticResource SettingsAccent}" BorderBrush="{StaticResource SettingsAccent}"
              BorderThickness="1" Command="{Binding ImportCommand}" />
      <Button DockPanel.Dock="Right" Content="Cancel" Margin="0,0,8,0" Padding="11,5" FontSize="13"
              Cursor="Hand" IsCancel="True" Foreground="{StaticResource SettingsText}"
              Background="{StaticResource SettingsApp2}" BorderBrush="{StaticResource SettingsLine}"
              BorderThickness="1" />
      <Button DockPanel.Dock="Right" Content="Refresh" Margin="0,0,8,0" Padding="11,5" FontSize="13"
              Cursor="Hand" Foreground="{StaticResource SettingsText}"
              Background="{StaticResource SettingsApp2}" BorderBrush="{StaticResource SettingsLine}"
              BorderThickness="1" Command="{Binding RefreshCommand}" />
    </DockPanel>

    <Grid>
      <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"
                 Foreground="{StaticResource SettingsDim}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                 Text="Nothing to import — every Windows Terminal window is already bound." />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Candidates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SettingsApp2}" BorderBrush="{StaticResource SettingsLine}"
                      BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" VerticalAlignment="Center"
                              Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3"
                            Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox DockPanel.Dock="Left" Width="180" Padding="6,4" FontSize="12"
                             FontFamily="Cascadia Mono,Consolas" VerticalAlignment="Center"
                             Background="{StaticResource SettingsField}"
                             Foreground="{StaticResource SettingsText}"
                             CaretBrush="{StaticResource SettingsText}"
                             BorderBrush="{StaticResource SettingsLine}" BorderThickness="1"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SettingsMuted}"
                               Text="{Binding Title}" ToolTip="{Binding Title}" />
                  </DockPanel>
                  <TextBlock Margin="34,4,0,0" FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource SettingsError}" Text="{Binding Error}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
