<overlays:ActivatableOverlayWindow
        x:Class="Switchboard.App.Picker.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:Switchboard.App.Overlays"
        xmlns:vm="clr-namespace:Switchboard.App.ViewModels"
        Title="Switchboard quick launch"
        SizeToContent="WidthAndHeight"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="OverlayBackground" Color="#F512141A" />
    <SolidColorBrush x:Key="OverlayBorder" Color="#FF2C3140" />
    <SolidColorBrush x:Key="OverlayText" Color="#FFF1F3F6" />
    <SolidColorBrush x:Key="OverlayMuted" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="OverlaySub" Color="#FF8B93A3" />
    <SolidColorBrush x:Key="OverlayBadgeBorder" Color="#FF384056" />
    <SolidColorBrush x:Key="OverlayFieldBackground" Color="#FF1A1D26" />
  </Window.Resources>
  <Border Background="{StaticResource OverlayBackground}"
          BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
          CornerRadius="8" Padding="16" MinWidth="380">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}"
                VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{Binding ProposedName}" FontSize="14" FontWeight="SemiBold"
                   FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource OverlayText}" />
        <TextBlock Text="  new terminal" FontSize="12" Foreground="{StaticResource OverlayMuted}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="Profile — Tab cycles" FontSize="11" Foreground="{StaticResource OverlaySub}"
                 Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,0,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" MaxWidth="400" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ProfileChipViewModel}">
            <Border x:Name="Chip" BorderBrush="{StaticResource OverlayBadgeBorder}"
                    BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,6"
                    Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Chip_Click">
              <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource OverlayMuted}" />
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="#1FFFFFFF" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource OverlayText}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Directory" FontSize="11" Foreground="{StaticResource OverlaySub}"
                 Margin="0,0,0,4" />
      <Border Background="{StaticResource OverlayFieldBackground}"
              BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
              CornerRadius="5" Padding="8,5" Margin="0,0,0,10">
        <TextBox x:Name="DirectoryBox" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource OverlayText}" CaretBrush="{StaticResource OverlayText}"
                 FontSize="12.5" FontFamily="Cascadia Mono,Consolas" />
      </Border>

      <DockPanel>
        <CheckBox x:Name="KeepBox" IsChecked="{Binding Keep}" VerticalAlignment="Center"
                  Foreground="{StaticResource OverlayMuted}" Focusable="False">
          <TextBlock Text="keep (persist in registry)" FontSize="12" />
        </CheckBox>
        <TextBlock Text="Tab profile · Ctrl+K keep · Enter launches · Esc cancels" FontSize="11"
                   Foreground="{StaticResource OverlaySub}" HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </Border>
</overlays:ActivatableOverlayWindow>
