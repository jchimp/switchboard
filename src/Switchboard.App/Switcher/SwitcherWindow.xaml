<overlays:ActivatableOverlayWindow
        x:Class="Switchboard.App.Switcher.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:Switchboard.App.Overlays"
        xmlns:vm="clr-namespace:Switchboard.App.ViewModels"
        Title="Switchboard switcher"
        SizeToContent="WidthAndHeight"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <SolidColorBrush x:Key="OverlayBackground" Color="#F512141A" />
    <SolidColorBrush x:Key="OverlayBorder" Color="#FF2C3140" />
    <SolidColorBrush x:Key="OverlayText" Color="#FFF1F3F6" />
    <SolidColorBrush x:Key="OverlayMuted" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="OverlaySub" Color="#FF8B93A3" />
    <SolidColorBrush x:Key="OverlayBadgeBorder" Color="#FF384056" />
    <SolidColorBrush x:Key="OverlayHover" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="OverlayFieldBackground" Color="#FF1A1D26" />
  </Window.Resources>
  <Border Background="{StaticResource OverlayBackground}"
          BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
          CornerRadius="8" Padding="12">
    <StackPanel>
      <Border Background="{StaticResource OverlayFieldBackground}"
              BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
              CornerRadius="5" Padding="8,5" Margin="0,0,0,10">
        <TextBox x:Name="FilterBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource OverlayText}" CaretBrush="{StaticResource OverlayText}"
                 FontSize="13" FontFamily="Cascadia Mono,Consolas" />
      </Border>
      <ItemsControl ItemsSource="{Binding View}" x:Name="Cards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Non-virtualizing on purpose: recycling containers would churn the DWM
                 thumbnail registrations that hang off each card. 4 x 228 = 912. -->
            <WrapPanel MaxWidth="912" Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SwitcherRowViewModel}">
            <Border x:Name="Card" Width="216" Margin="6" Padding="6" CornerRadius="6"
                    BorderThickness="2" BorderBrush="Transparent" Background="Transparent"
                    Opacity="{Binding RowOpacity}" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click">
              <StackPanel>
                <!-- Live DWM thumbnail rect (SyncThumbnails). Nothing may overlay this slot:
                     DWM composites the thumbnail above the window's own visuals, so the
                     selection ring lives on the card border, never over the pixels. -->
                <Border x:Name="ThumbSlot" Height="115" CornerRadius="3"
                        Background="#FF101010" />
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,6,0"
                             VerticalAlignment="Center" />
                    <!-- Name split at fuzzy-match boundaries; hit segments render bright. -->
                    <ItemsControl ItemsSource="{Binding NameSegments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NameSegment}">
                          <TextBlock Text="{Binding Text}" FontSize="12.5"
                                     Foreground="{StaticResource OverlayMuted}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Hit}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource OverlayText}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Border Grid.Column="1" VerticalAlignment="Center"
                          BorderBrush="{StaticResource OverlayBadgeBorder}" BorderThickness="1"
                          CornerRadius="4" Padding="5,1"
                          Visibility="{Binding HasJumpKey, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding JumpKeyText}" FontSize="11"
                               FontFamily="Cascadia Mono,Consolas"
                               Foreground="{StaticResource OverlaySub}" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource OverlayHover}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#0AFFFFFF" />
              </DataTrigger>
              <!-- The selection ring; listed last so it wins over the IsActive background. -->
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Brush}" />
                <Setter TargetName="Card" Property="Background" Value="#14FFFFFF" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</overlays:ActivatableOverlayWindow>
