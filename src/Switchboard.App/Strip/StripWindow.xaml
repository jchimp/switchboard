<Window x:Class="Switchboard.App.Strip.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Switchboard.App.ViewModels"
        Title="Switchboard strip"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False">
  <!-- The menu (SwitchboardMenu, set in code) is its own HWND and takes focus only while
       open, at the user's explicit request; focus returns on close. The strip itself never
       activates (ADR-0006). -->
  <Border Background="{StaticResource StripBackground}" x:Name="StripFrame">
    <ItemsControl ItemsSource="{Binding Items}" x:Name="Segments">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid x:Name="Panel" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:TerminalItemViewModel}">
          <Border x:Name="Seg"
                  Background="{Binding Fill}"
                  BorderBrush="{StaticResource StripSeparator}" BorderThickness="0,0,1,1"
                  ToolTip="{Binding ToolTip}"
                  Cursor="Hand"
                  MouseLeftButtonUp="Segment_Click">
            <!-- Opacity lives in the style, not as an attribute: a local value would outrank
                 the trigger. -->
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Opacity" Value="{Binding Opacity}" />
                <Style.Triggers>
                  <!-- A 2-4 px sliver reads brightness, not hue, so the grey tint alone
                       looks "on". Closed segments become near-gaps there instead. -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsClosed}" Value="True" />
                      <Condition Binding="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.12" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Border.Effect>
              <DropShadowEffect ShadowDepth="0" BlurRadius="{Binding GlowRadius}" Color="{Binding Brush.Color}" />
            </Border.Effect>
            <!-- Brightness overlay the pulse animates: a color pulse reads even in the
                 2 px auto-hide sliver, and it leaves Seg.Opacity to its binding. -->
            <Border x:Name="PulseOverlay" Background="White" Opacity="0" IsHitTestVisible="False" />
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding WantsAttention}" Value="True">
              <DataTrigger.EnterActions>
                <!-- Attention pulse: the one piece of unprompted motion in the product. -->
                <BeginStoryboard x:Name="PulseStart">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PulseOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.45" Duration="0:0:0.6" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <StopStoryboard BeginStoryboardName="PulseStart" />
              </DataTrigger.ExitActions>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
