<Window x:Class="Switchboard.App.Rail.RailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Switchboard.App.ViewModels"
        xmlns:rail="clr-namespace:Switchboard.App.Rail"
        Title="Switchboard rail"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <SolidColorBrush x:Key="RailBackground" Color="#F012141A" />
    <SolidColorBrush x:Key="RailBorder" Color="#FF2C3140" />
    <SolidColorBrush x:Key="RailText" Color="#FFF1F3F6" />
    <SolidColorBrush x:Key="RailMuted" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="RailSub" Color="#FF8B93A3" />
    <SolidColorBrush x:Key="RailBadgeBorder" Color="#FF384056" />
    <SolidColorBrush x:Key="RailHover" Color="#0DFFFFFF" />
  </Window.Resources>
  <Border x:Name="RailFrame" Background="{StaticResource RailBackground}"
          BorderBrush="{StaticResource RailBorder}" BorderThickness="1">
    <!-- Right-click menu is built in code (SwitchboardMenu) so it can't drift from the
         strip's or the "…" button's. -->
    <DockPanel>
      <!-- The "…" button's slot. Its own column on the top edge (RailMetrics.MenuSlotDips),
           a row at the bottom on side edges (ApplyOrientation). Never over a card: the
           cards' DWM thumbnails composite above the rail's own visuals and would cover it. -->
      <Border DockPanel.Dock="Right" x:Name="MenuSlot">
        <Border x:Name="MoreButton" Width="28" Height="28" CornerRadius="4"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Cursor="Hand" ToolTip="More" MouseLeftButtonDown="MoreButton_Pressed"
                MouseLeftButtonUp="MoreButton_Click" MouseLeave="MoreButton_Left">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource RailHover}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                     FontSize="14" Foreground="{StaticResource RailMuted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    x:Name="ListScroller" Padding="8,8,8,8" ScrollChanged="ListScroller_ScrollChanged">
        <ItemsControl ItemsSource="{Binding Items}" x:Name="Rows">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel x:Name="RowsPanel" Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RailItemViewModel}">
              <Border x:Name="Card" Width="{x:Static rail:RailMetrics.CardWidthDips}"
                      Margin="0,3" Padding="6" CornerRadius="6"
                      BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                      Opacity="{Binding RowOpacity}" Cursor="Hand"
                      MouseLeftButtonUp="Row_Click">
                <StackPanel>
                  <!-- Thumb slot: dark background shows through when no live thumbnail is
                       registered (Closed terminals); a live DWM thumbnail is drawn directly
                       into this rect of the rail's own window (RailWindow.SyncThumbnails).
                       16:9 (204x115) to match a typical terminal, so DWM's aspect-preserving
                       fit leaves no letterbox bars. Nothing may overlay this slot: DWM
                       composites the live thumbnail above the rail's own visuals. -->
                  <Border x:Name="ThumbSlot" Height="115" CornerRadius="3"
                          Background="#FF101010" />
                  <!-- 4, not 5: the 14-pt name left 0.6 DIP of room in the fixed 190-DIP top rail,
                       and a card that overflows it loses its live thumbnail. -->
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource RailText}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Rename/recolor affordance; revealed on row hover (ADR-0014). Hidden, not
                         Collapsed, so the number badge never shifts when it appears. -->
                    <TextBlock x:Name="EditPencil" Grid.Column="1" Text="✎" FontSize="12"
                               Foreground="{StaticResource RailMuted}" Cursor="Hand"
                               Margin="6,0,6,0" VerticalAlignment="Center" Visibility="Hidden"
                               MouseLeftButtonUp="Rename_Click" />
                    <!-- The jump number sits at the card's right edge, in line with the strip. -->
                    <Border Grid.Column="2" VerticalAlignment="Center"
                            BorderBrush="{StaticResource RailBadgeBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="5,1"
                            Visibility="{Binding HasJumpKey, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding JumpKeyText}" FontSize="11"
                                 FontFamily="Cascadia Mono,Consolas"
                                 Foreground="{StaticResource RailSub}" />
                    </Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <TextBlock Text="{Binding SubLine}" FontSize="11" FontFamily="Cascadia Mono,Consolas"
                               Foreground="{StaticResource RailSub}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text=" ●" FontSize="11" Foreground="{Binding Brush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Card" Property="Background" Value="{StaticResource RailHover}" />
                  <Setter TargetName="EditPencil" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Brush}" />
                  <Setter TargetName="Card" Property="Background" Value="#0AFFFFFF" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
