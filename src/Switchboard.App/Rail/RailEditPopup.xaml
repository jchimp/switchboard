<Window x:Class="Switchboard.App.Rail.RailEditPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switchboard edit"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" SizeToContent="Height" Width="264">
  <!-- The one activatable window in the product (ADR-0012/0014): opened only by an explicit
       click on an edit affordance; the previous foreground window is restored on close. -->
  <Border Background="#FA14161D" BorderBrush="#FF2F3646" BorderThickness="1"
          CornerRadius="8" Padding="14,12">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold"
                 Foreground="#FFF1F3F6" Margin="0,0,0,8" />
      <TextBox x:Name="NameBox" FontSize="12" Padding="4,3"
               Background="#FF0E1016" Foreground="#FFF1F3F6"
               BorderBrush="#FF384056" CaretBrush="#FFF1F3F6" />
      <WrapPanel x:Name="Swatches" Margin="0,10,0,0" />
      <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#FFEF6B6B"
                 TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="Cancel" IsCancel="True" Padding="10,3" Margin="0,0,6,0" />
        <Button Content="Save" IsDefault="True" Padding="10,3" Click="Save_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
